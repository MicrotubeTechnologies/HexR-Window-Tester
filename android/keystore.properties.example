# Copy to `keystore.properties` and fill in. That file is gitignored; this one
# is the shape of it, committed so nobody has to guess the key names.
#
# Create the upload keystore first (JDK 17's keytool, once, ever). One line,
# because PowerShell does not join backslash continuations and would run only
# the first fragment -- which quietly makes a 90-day certificate:
#
#   keytool -genkeypair -v -keystore hexr-upload.jks -alias hexr-upload -keyalg RSA -keysize 4096 -validity 10000 -dname "CN=Microtube, O=Microtube, C=GB"
#
# `-validity 10000` is required, not cosmetic: Play rejects a bundle whose
# certificate expires before 22 October 2033, and keytool defaults to 90 days.
#
# Then back up `hexr-upload.jks` and its passwords somewhere that is not this
# machine. Play App Signing means a lost upload key can be reset by Google, but
# only after a support round-trip you do not want to be having mid-release.

# Path to the keystore. Relative paths resolve against this `android/` directory.
storeFile=hexr-upload.jks
storePassword=
keyAlias=hexr-upload
keyPassword=
