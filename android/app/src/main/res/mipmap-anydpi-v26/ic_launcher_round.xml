<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icons only, with no density-specific PNG fallbacks: minSdk is 26 and
  adaptive icons landed in 26, so every device that can install this app can
  render one.

  Accent mark on the app's own ground, rather than the reverse. The app is dark
  everywhere and the mark is orange everywhere in it; a white-on-orange tile
  would be the one place the identity flipped.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/screen" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
