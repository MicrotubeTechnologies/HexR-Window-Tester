<?xml version="1.0" encoding="utf-8"?>
<!--
  The HEXR mark from the design handoff: a pointy-top hexagon outline with a
  smaller filled hexagon - the channel dot - at its centre. The same mark the
  app draws in its header lockup and on the splash, so the launcher icon and the
  first screen are the same object.

  Geometry is the handoff's 60x60 polygon scaled 1.1x about the centre of the
  108dp adaptive-icon canvas. With its 5dp stroke the mark spans 60x64dp, inside
  the 72dp circle a launcher may mask to.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M54,24.3 L81.5,39.15 L81.5,68.85 L54,83.7 L26.5,68.85 L26.5,39.15 Z"
        android:strokeColor="#F4762A"
        android:strokeWidth="5"
        android:strokeLineJoin="round" />

    <path
        android:pathData="M54,43 L66.1,50.15 L66.1,57.85 L54,65 L41.9,57.85 L41.9,50.15 Z"
        android:fillColor="#F4762A" />
</vector>
